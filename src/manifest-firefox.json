{
  "name": "Bandcamp Keyboard Shortcuts",
  "short_name": "BC Shortcuts",
  "description": "Keyboard shortcuts for an enhanced Bandcamp browsing workflow: Vim-style hotkeys, waveform seeking, speed, wishlist & cart.",
  "version": "1.8",
  "homepage_url": "https://github.com/npp1993/bandcamp-keyboard-shortcuts",
  "manifest_version": 2,
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_title": "Bandcamp Keyboard Shortcuts",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "*://*.bandcamp.com/*",
    "https://t4.bcbits.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.bandcamp.com/*"],
      "js": ["scripts/content.js"],
      "css": ["assets/content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
